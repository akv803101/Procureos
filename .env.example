# ── App ────────────────────────────────────────────────────
APP_ENV=development                    # development | staging | production
BASE_URL=https://api.procureos.in/v1
FRONTEND_URL=https://app.procureos.in
SECRET_KEY=your-secret-key-min-32-chars

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...            # Service role key — never expose to client
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_POSTGRES_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM Providers ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
GROQ_API_KEY=gsk_...

# Override default model per task (optional)
LLM_INTENT_PARSER_MODEL=groq/llama-3.1-8b-instant
LLM_QUOTE_PARSER_MODEL=anthropic/claude-sonnet-4-6
LLM_ORCHESTRATOR_MODEL=anthropic/claude-sonnet-4-6

# ── Google Places ───────────────────────────────────────────
GOOGLE_PLACES_API_KEY=AIza...

# ── Flights ────────────────────────────────────────────────
SKYSCANNER_API_KEY=
IXIGO_API_KEY=

# ── WhatsApp (Chat Mitra WABA) ──────────────────────────────
CHAT_MITRA_API_KEY=
CHAT_MITRA_WABA_NUMBER=+91...
META_WEBHOOK_SECRET=                   # For HMAC verification of incoming webhooks
META_WEBHOOK_VERIFY_TOKEN=             # For WhatsApp webhook URL verification
RFQ_TEST_RECIPIENT=                    # Set to your own WhatsApp number to self-test the
                                       # send->reply loop (routes every RFQ to you, real
                                       # vendor name+REF preserved). Empty = send to real vendors.

# ── Exotel (Auto-call fallback) ─────────────────────────────
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=
EXOTEL_CALLER_ID=+91...

# ── Razorpay (Payment — test mode) ──────────────────────────
RAZORPAY_KEY_ID=rzp_test_...           # use TEST keys for the demo (no real money)
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=               # HMAC (X-Razorpay-Signature) on the payment webhook

# ── Demo ────────────────────────────────────────────────────
# SAFETY: true = discover only SEEDED vendors, so RFQs reach your own number(s),
# never real strangers. Keep true for any demo/dev run; false uses live Google Places.
DEMO_MODE=true

# ── Zoho Books ─────────────────────────────────────────────
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=

# ── Slack ──────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=                  # Fix 11 — HMAC verification
SLACK_APP_ID=

# ── Monitoring ─────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...
